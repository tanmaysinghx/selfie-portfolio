{
  "name": "selfie-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "blog": "node scripts/build-blog.mjs --drafts",
    "prestart": "node scripts/build-blog.mjs --drafts",
    "start": "ng serve",
    "start:keystone": "node --env-file-if-exists=.env.local scripts/dev-with-keystone.mjs",
    "test:stats": "node scripts/test-stats.mjs",
    "prebuild": "node scripts/build-blog.mjs",
    "build": "ng build",
    "postbuild": "node scripts/prerender-blog.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "chart.js": "^4.6.1",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "mermaid": "^12.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
