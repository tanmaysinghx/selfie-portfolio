# Server-only settings for the Vercel functions in /api. Never put these in Angular code.
# Production: Vercel → Project → Settings → Environment Variables.
# Local: copy to .env.local, set the API key, and run `npm start`.
# Optional override; the code defaults to https://selfie.tanmaysinghx.com/.
# BACKEND_URL=https://selfie.tanmaysinghx.com/
BACKEND_API_KEY=
