# Copy to .env for local development. In production, set these in your host's dashboard.

# MySQL connection. jdbc:mysql://… URLs are accepted too. Aiven needs ssl-mode=required.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/selfie?ssl-mode=required
DB_MAX_CONNECTIONS=5

# Shared secret the frontend's Vercel functions send as x-api-key (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVICE_API_KEY=

# Bearer token for /api/v1/admin/* (>= 32 chars). Leave empty to disable admin routes.
ADMIN_TOKEN=

# Mixed into visitor ids before hashing (>= 16 chars). Changing it resets like/view dedupe.
VISITOR_HASH_SALT=

# off | links (hold comments containing links) | all (hold every comment)
COMMENT_MODERATION=links

# Only needed if a browser calls the API directly. The Vercel gateway does not need CORS.
CORS_ALLOWED_ORIGINS=

HOST=127.0.0.1
PORT=8787
# pretty | json
LOG_FORMAT=pretty
# RUST_LOG=selfie_backend=debug,tower_http=info
